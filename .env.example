# SilvaPass Environment Configuration Example
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Local Database
DATABASE_URL=sqlite:///./silvapass.db

# Blockchain / Hardhat Local Node
EVM_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Default Hardhat account 0 (for local testing only - DO NOT USE WITH REAL ASSETS)
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SILVAPASS_REGISTRY_ADDRESS=

# Environmental Screening (FAO WHISP)
# Mode: "LIVE", "SNAPSHOT", or "SIMULATION"
WHISP_MODE=SNAPSHOT
WHISP_API_URL=https://whisp.openforis.org/api
WHISP_API_KEY=

# Document Extraction AI Configuration
# Mode: "MOCK" or "LIVE"
EXTRACTION_MODE=MOCK
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_API_KEY=

# Frontend (Vite)
VITE_BACKEND_API_URL=http://127.0.0.1:8000
